erDiagram
    PATIENT {
        uuid patient_id PK
        string full_name
        date birth_date
        string phone
        string email
        string address
        datetime registration_date
    }

    DOCTOR {
        uuid doctor_id PK
        string full_name
        uuid specialty_id FK
        string phone
        string email
        date hire_date
        string license_number
    }

    SPECIALTY {
        uuid specialty_id PK
        string name
        string description
    }

    ROOM {
        uuid room_id PK
        string number
        int floor
        string equipment_description
    }

    SERVICE {
        uuid service_id PK
        string name
        string description
        decimal price
        int duration_minutes
        string category
    }

    APPOINTMENT {
        uuid appointment_id PK
        uuid patient_id FK
        uuid doctor_id FK
        uuid room_id FK
        datetime date_time
        string status
        string notes
    }

    INVOICE {
        uuid invoice_id PK
        uuid appointment_id FK
        datetime issue_date
        decimal total_amount
        string payment_status
        string payment_method
        datetime paid_date
    }

    SPECIALTY ||--o{ DOCTOR      : "об'єднує лікарів"
    PATIENT   ||--o{ APPOINTMENT : "записується на"
    DOCTOR    ||--o{ APPOINTMENT : "проводить"
    ROOM      ||--o{ APPOINTMENT : "приймає в"
    APPOINTMENT }o--o{ SERVICE   : "включає"
    APPOINTMENT ||--o| INVOICE   : "формує"
