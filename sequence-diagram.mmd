%% Sequence diagram — запис пацієнта на прийом через онлайн-форму (UC1, REQ-01, REQ-02)
%% Ланцюг: Patient -> Web App -> Booking Service -> Database
%% Додатково: Booking Service -> SMS Gateway (опційне SMS-підтвердження, блок opt)
%% Назви сутностей і атрибутів (PATIENT, DOCTOR, ROOM, SERVICE, APPOINTMENT, actual_price)
%% збігаються з концептуальною моделлю з er-diagram.mmd.
%% Return-повідомлення показані пунктирними стрілками (-->>).
sequenceDiagram
    autonumber
    actor Patient
    participant WebApp as Web App
    participant Booking as Booking Service
    participant DB as Database
    participant SMSGateway as SMS Gateway

    Patient->>WebApp: Select doctor, date and time slot (doctor_id, room_id, date_time)

    loop For each service selected by the patient
        Patient->>WebApp: Add service to booking
        WebApp->>+Booking: getService(service_id)
        Booking->>+DB: findServiceById(service_id)
        DB-->>-Booking: SERVICE (name, price, duration_minutes)
        Booking-->>-WebApp: Service details
        WebApp-->>Patient: Update selected services, total price and duration
    end

    Patient->>WebApp: Submit booking form (optionally with phone number or SMS confirmation)
    WebApp->>Booking: createAppointment(patient_id, doctor_id, room_id, date_time, service_ids[], sms_confirmation, phone)

    Booking->>+DB: findPatientById(patient_id)
    DB-->>-Booking: PATIENT
    Booking->>+DB: findServicesByIds(service_ids[])
    DB-->>-Booking: SERVICE[] (price, duration_minutes)
    Booking->>Booking: calculateTotalDuration(services)
    Booking->>+DB: findConflictingAppointments(doctor_id, room_id, date_time, duration_minutes)
    DB-->>-Booking: Conflicting APPOINTMENT list

    alt Time slot is free (no conflicts)
        Note over Booking,DB: Saved in one transaction
        Booking->>+DB: saveAppointment(patient_id, doctor_id, room_id, date_time, duration_minutes, status = scheduled)
        DB-->>-Booking: appointment_id
        Booking->>+DB: saveAppointmentServices(appointment_id, service_ids[], actual_price)
        DB-->>-Booking: Services linked

        opt Patient entered a phone number or chose SMS confirmation
            Booking->>+SMSGateway: sendSms(phone, message_text)
            SMSGateway-->>-Booking: Delivery status (SENT)
        end

        Booking-->>WebApp: 201 Created (appointment_id, status = scheduled, sms_status)
        WebApp-->>Patient: Show booking confirmation

        opt SMS delivery status is SENT
            WebApp-->>Patient: Show message "SMS confirmation sent"
        end
    else Time slot is already taken
        Booking-->>WebApp: 409 Conflict (SLOT_UNAVAILABLE)
        WebApp-->>Patient: Show error and ask to choose another time
    end
