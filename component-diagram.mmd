flowchart TB
    Users(["Patient, Doctor, Administrator"]):::actor

    subgraph SYS["Система клініки A-Dent (межа системи)"]
        direction TB
        subgraph UI["Рівень UI"]
            WebApp["<b>Web App</b><br/>uk-UA, 360-1920 px (NFR-01, NFR-08)<br/>required: IRestApi"]:::comp
        end
        subgraph API["Рівень API"]
            Controller["<b>REST API Controller</b><br/>JSON (NFR-04, NFR-09), limit 150 RPS: 429 (NFR-02, NFR-03)<br/>provided: IRestApi<br/>required: IBookingApi, ICatalogApi, IBillingApi"]:::comp
        end
        subgraph SVC["Рівень сервісів"]
            Booking["<b>Booking Service</b><br/>UC0..UC4, UC6, UC10, UC11 (REQ-01..03, REQ-08, REQ-09, REQ-13, REQ-15..20)<br/>validateJwt (401, NFR-05..07), calculateTotalDuration<br/>provided: IBookingApi<br/>required: IPatientRepository, IServiceRepository, IAppointmentRepository, IRoomRepository, ISmsGateway"]:::comp
            Catalog["<b>Catalog Service</b><br/>UC12, UC12a..c (REQ-11, REQ-12)<br/>provided: ICatalogApi<br/>required: IServiceRepository, IRoomRepository, ISpecialtyRepository, IDoctorRepository"]:::comp
            Billing["<b>Billing Service</b><br/>UC5, UC7, UC8, UC9 (REQ-04..07, REQ-10, REQ-14)<br/>provided: IBillingApi<br/>required: IInvoiceRepository, IAppointmentRepository"]:::comp
        end

        subgraph DA["Рівень Data Access"]
            PatientRepo["<b>PatientRepository</b> (PATIENT)<br/>provided: IPatientRepository | required: SQL"]:::repo
            ServiceRepo["<b>ServiceRepository</b> (SERVICE)<br/>provided: IServiceRepository | required: SQL"]:::repo
            AppRepo["<b>AppointmentRepository</b> (APPOINTMENT, APPOINTMENT_SERVICE)<br/>provided: IAppointmentRepository | required: SQL (BEGIN, COMMIT, ROLLBACK)"]:::repo
            RoomRepo["<b>RoomRepository</b> (ROOM)<br/>provided: IRoomRepository | required: SQL"]:::repo
            InvoiceRepo["<b>InvoiceRepository</b> (INVOICE)<br/>provided: IInvoiceRepository | required: SQL"]:::repo
            SpecialtyRepo["<b>SpecialtyRepository</b> (SPECIALTY)<br/>provided: ISpecialtyRepository | required: SQL"]:::repo
            DoctorRepo["<b>DoctorRepository</b> (DOCTOR, SPECIALTY M:M)<br/>provided: IDoctorRepository | required: SQL"]:::repo
        end
        subgraph DBL["Рівень бази даних"]
            DB[("<b>PostgreSQL</b> (NFR-04, NFR-09)<br/>PATIENT, DOCTOR, SPECIALTY, ROOM, SERVICE,<br/>APPOINTMENT, APPOINTMENT_SERVICE, INVOICE<br/>provided: SQL")]:::db
        end
    end
    subgraph EXT["Зовнішні сервіси"]
        SMS[["<b>SMS Gateway</b><br/>provided: ISmsGateway"]]:::ext
    end

    Users --> WebApp
    WebApp -.->|"IRestApi (JSON)"| Controller

    Controller -.->|"IBookingApi: signIn (UC0), createAppointment (UC1), getAvailableSlots,<br/>getService, getSchedule (UC4), completeAppointment (UC6),<br/>cancelAppointment (UC3), getPatientAppointments (UC2, UC11)"| Booking
    Controller -.->|"ICatalogApi: manageSpecialties (UC12a), manageRooms (UC12b), manageServices (UC12c)"| Catalog
    Controller -.->|"IBillingApi: createInvoice (UC5), registerPayment (UC7),<br/>viewInvoices (UC8), registerRefund (UC9), checkUninvoiced (REQ-14)"| Billing

    Booking -.->|"IPatientRepository: findPatientById"| PatientRepo
    Booking -.->|"IServiceRepository: findServiceById, findServicesByIds"| ServiceRepo
    Booking -.->|"IAppointmentRepository: findAvailableSlots, findConflictingAppointments,<br/>saveAppointment, saveAppointmentServices (BEGIN, COMMIT, ROLLBACK)"| AppRepo
    Booking -.->|"IRoomRepository: findAvailableRoom"| RoomRepo

    Catalog -.->|"IServiceRepository"| ServiceRepo
    Catalog -.->|"IRoomRepository"| RoomRepo
    Catalog -.->|"ISpecialtyRepository"| SpecialtyRepo
    Catalog -.->|"IDoctorRepository"| DoctorRepo

    Billing -.->|"IInvoiceRepository: save/update INVOICE"| InvoiceRepo
    Billing -.->|"IAppointmentRepository: read actual_price, update status"| AppRepo

    PatientRepo -->|"SQL"| DB
    ServiceRepo -->|"SQL"| DB
    AppRepo -->|"SQL"| DB
    RoomRepo -->|"SQL"| DB
    InvoiceRepo -->|"SQL"| DB
    SpecialtyRepo -->|"SQL"| DB
    DoctorRepo -->|"SQL"| DB

    Booking -.->|"ISmsGateway: sendSms (UC10, REQ-09)"| SMS

