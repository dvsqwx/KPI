%% Use Case діаграма — «Приватна стоматологічна клініка A-Dent»
%% Примітка щодо нотації: Mermaid не має єдиної стабільної across-renderer нотації
%% класичного UML use-case (порожній трикутник генералізації, людські акторні "стіки").
%% Тому діаграма побудована на flowchart, що гарантовано рендериться в будь-якій версії Mermaid:
%%   - актори-люди: заокруглений прямокутник (stadium), клас actorHuman
%%   - зовнішня система (Платіжна система): подвійна рамка (subroutine), клас actorSystem, пунктирна межа
%%   - use case: овал (stadium) всередині підсистеми SYS
%%   - асоціація актор–use case: звичайна лінія без стрілки
%%   - «include»: пунктирна стрілка з підписом «include», від базового UC до включеного
%%   - «extend»: пунктирна стрілка з підписом «extend», від розширення до базового UC
%%   - генералізація: суцільна стрілка з підписом "generalization" (наближення — замінює порожній трикутник)

flowchart LR

    %% ===== Актори =====
    Patient(["🧍 Пацієнт"]):::actorHuman
    Doctor(["🧍 Лікар"]):::actorHuman
    Admin(["🧍 Адміністратор"]):::actorHuman
    Staff(["🧍 Персонал клініки"]):::actorHuman
    PaymentSys[["💳 Платіжна система"]]:::actorSystem

    %% Генералізація акторів: Лікар і Адміністратор — спеціалізації Персоналу клініки
    Doctor -->|"generalization"| Staff
    Admin -->|"generalization"| Staff

    %% ===== Межа системи =====
    subgraph SYS["Інформаційна система клініки «A-Dent»"]
        direction TB

        UC0(["Увійти в систему"])

        UC1(["Записатися на прийом"])
        UC2(["Переглянути свої прийоми"])
        UC3(["Скасувати запис на прийом"])
        UC4(["Переглянути розклад прийомів"])
        UC5(["Провести прийом"])
        UC6(["Сформувати рахунок"])
        UC7(["Оплатити рахунок"])
        UC8(["Обробити платіж"])
        UC9(["Повернути кошти"])
        UC10(["Надіслати нагадування про прийом"])
        UC11(["Переглянути історію лікування"])

        UC12(["Керувати довідниками"])
        UC12a(["Керувати спеціальностями"])
        UC12b(["Керувати кабінетами"])
        UC12c(["Керувати послугами"])
    end

    %% ===== Асоціації: Пацієнт =====
    Patient --- UC1
    Patient --- UC2
    Patient --- UC3
    Patient --- UC7
    Patient --- UC11

    %% ===== Асоціації: успадковано через Staff, плюс власні =====
    Staff --- UC0
    Doctor --- UC4
    Doctor --- UC5
    Admin --- UC1
    Admin --- UC3
    Admin --- UC4
    Admin --- UC9
    Admin --- UC12

    %% ===== Асоціація: зовнішня система =====
    PaymentSys --- UC8

    %% ===== Include (обов'язковий крок) =====
    UC5 -.->|"«include»"| UC6
    UC7 -.->|"«include»"| UC8

    %% ===== Extend (опційне розширення за умови) =====
    UC10 -.->|"«extend» [за 24 год до прийому]"| UC1
    UC9 -.->|"«extend» [прийом оплачено і скасовано]"| UC7

    %% ===== Генералізація use cases =====
    UC12a -->|"generalization"| UC12
    UC12b -->|"generalization"| UC12
    UC12c -->|"generalization"| UC12

    classDef actorHuman fill:#eef2ff,stroke:#33415c,stroke-width:1px;
    classDef actorSystem fill:#fff1f0,stroke:#9b2c2c,stroke-width:1px,stroke-dasharray:4 2;
