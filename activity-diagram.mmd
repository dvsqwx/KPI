%% Activity diagram — процес запису пацієнта на прийом (UC1 разом із входом UC0 та SMS-підтвердженням UC10), spec.md розділ 11.
%% Нотація (Mermaid flowchart): доріжки ролей — subgraph; початок — чорне коло; кінець — подвійне коло;
%% ромб — перевірка if/else; чорні смуги Fork і Join — паралельні гілки (форми fork/join потребують Mermaid 11.3+).
%% Доріжки оголошено у зворотному порядку: так Mermaid розташовує їх зліва направо як Patient, Web App, Booking Service, Database, SMS Gateway.
%% Назви методів і полів збігаються зі spec.md, sequence-diagram.mmd та er-diagram.mmd.
flowchart TB

    subgraph SMSLane["SMS Gateway"]
        direction TB
        S1["sendSms(phone, message_text)"]
        S2{"Delivered?"}
    end

    subgraph DatabaseLane["Database"]
        direction TB
        D1["findServiceById(service_id)"]
        D2["findAvailableSlots(doctor_id, date, total_duration), working hours 09:00-18:00"]
        D3["BEGIN transaction"]
        D4["findAvailableRoom(date_time, duration_minutes)"]
        D5["findConflictingAppointments(doctor_id, room_id, date_time, duration_minutes)"]
        D6{"Doctor or room conflict?"}
        D7["ROLLBACK"]
        D8["saveAppointment, saveAppointmentServices (status = scheduled, actual_price)"]
        D9["COMMIT"]
    end

    subgraph BookingLane["Booking Service"]
        direction TB
        B1["getService(service_id)"]
        B2["getAvailableSlots(doctor_id, date, total_duration)"]
        B3["validateJwt(access_token)"]
        B4{"JWT valid?"}
        B5["401 Unauthorized (database is not queried)"]
        B6["findPatientById, findServicesByIds, calculateTotalDuration"]
        B7["409 Conflict (SLOT_UNAVAILABLE)"]
        Fork@{ shape: fork, label: "Fork" }
        B8["201 Created (appointment_id, status = scheduled)"]
        B9{"SMS requested (UC10)?"}
        B10["sms_status = SENT"]
        B11["sms_status = FAILED (APPOINTMENT stays scheduled)"]
        Join@{ shape: fork, label: "Join" }
        End(((" "))):::endNode
    end

    subgraph WebAppLane["Web App"]
        direction TB
        W1["Request service data"]
        W2["Update service list, total price and total_duration"]
        W3["Request free slots for total_duration"]
        W4{"Free slots on this date?"}
        W5["Show message: no free time on this date"]
        W6["Display available time slots"]
        W7["Send createAppointment request"]
        W8["Redirect to sign-in page"]
        W9["Show booking page"]
        W10["Show error: time or room is taken, selected services are kept"]
        W11["Show booking confirmation"]
    end

    subgraph PatientLane["Patient"]
        direction TB
        Start((" ")):::startNode
        P1["Select doctor"]
        P2["Add service to booking"]
        P3{"Add another service?"}
        P4["Select date"]
        P5["Pick time slot and submit booking form"]
        P6["Sign in (UC0)"]
    end

    %% Вибір послуг (цикл) і підрахунок total_duration
    Start --> P1 --> P2 --> W1 --> B1 --> D1 --> W2 --> P3
    P3 -->|"yes"| P2
    P3 -->|"no"| P4

    %% Пошук вільних слотів
    P4 --> W3 --> B2 --> D2 --> W4
    W4 -->|"no: choose another date"| W5
    W5 --> P4
    W4 -->|"yes"| W6 --> P5 --> W7 --> B3 --> B4

    %% Перевірка JWT
    B4 -->|"no"| B5 --> W8 --> P6 --> W9 --> P4
    B4 -->|"yes"| B6 --> D3 --> D4 --> D5 --> D6

    %% Транзакція: конфлікт або збереження
    D6 -->|"conflict"| D7 --> B7 --> W10
    W10 -->|"choose another time"| P4
    D6 -->|"no conflict"| D8 --> D9 --> Fork

    %% Fork: відповідь клієнту і SMS паралельно
    Fork --> B8 --> W11 --> Join
    Fork --> B9
    B9 -->|"yes"| S1 --> S2
    S2 -->|"SENT"| B10 --> Join
    S2 -->|"error or timeout"| B11 --> Join
    B9 -->|"no"| Join
    Join --> End

    classDef startNode fill:#000,stroke:#000,color:#000;
    classDef endNode fill:#fff,stroke:#000,stroke-width:3px,color:#000;
    classDef errorNode fill:#ffe3e3,stroke:#c92a2a,color:#1a1a1a;
    classDef okNode fill:#e3fafc,stroke:#0b7285,color:#1a1a1a;
    classDef bar fill:#000,stroke:#000;
    class Fork,Join bar;
    class W5,W10,B5,B7,D7,B11 errorNode;
    class W11,B8,D9,B10 okNode;